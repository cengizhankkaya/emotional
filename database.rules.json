{
    "rules": {
        "reports": {
            "$reportId": {
                ".read": false,
                ".write": "auth != null && !data.exists() && newData.child('reporterUserId').val() === auth.uid"
            }
        },
        "users": {
            "$userId": {
                "blockedUsers": {
                    ".read": "auth != null && auth.uid === $userId",
                    ".write": "auth != null && auth.uid === $userId"
                }
            }
        },
        "rooms": {
            "$roomId": {
                ".read": "auth != null",
                ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid && newData.child('users').hasChild(auth.uid)) || data.child('users').hasChild(auth.uid))",
                "users": {
                    "$userId": {
                        ".write": "auth != null && auth.uid === $userId && (!newData.exists() || root.child('rooms').child($roomId).child('host').exists())",
                        ".validate": "newData.isString() && newData.val().length <= 100"
                    }
                },
                "signal": {
                    "$userId": {
                        ".read": "auth != null && auth.uid === $userId",
                        ".write": "auth != null && auth.uid === $userId",
                        "$signalType": {
                            "$senderId": {
                                ".write": "auth != null && auth.uid === $senderId"
                            }
                        }
                    }
                },
                "usersState": {
                    "$userId": {
                        ".write": "auth != null && auth.uid === $userId"
                    }
                },
                "messages": {
                    "$messageId": {
                        ".validate": "data.exists() || newData.child('senderId').val() === auth.uid"
                    }
                }
            }
        }
    }
}
